<?xml version='1.0' encoding='utf-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="S2 disposable Square cursor first page" enabled="true">
      <stringProp name="TestPlan.comments">Run through run_s2_jmeter.py only. The default host is deliberately unroutable. No login credentials, token, response body, or URL are saved in the JTL.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables" enabled="true">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S2 paced persistent users" enabled="true">
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(benchUsers,128)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">2</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(benchTotalSeconds,50)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(benchPrelude,3)}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Target RPS across persistent users" enabled="true">
          <stringProp name="throughput">${__P(benchPerMinute,6000)}</stringProp>
          <intProp name="calcMode">1</intProp>
        </ConstantThroughputTimer>
        <hashTree />
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer from process environment" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Authorization" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${__groovy(System.getenv('PEERGRAB_BENCH_TOKEN'))}</stringProp>
            </elementProp>
            <elementProp name="Accept" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S2" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Parameters" enabled="true">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(benchHost,invalid.invalid)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(benchPort,443)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(benchScheme,https)}</stringProp>
          <stringProp name="HTTPSampler.path">${__groovy(System.getenv('PEERGRAB_BENCH_PREFIX'))}/api/errands?campusId=1&amp;cursor=&amp;size=20</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${__P(benchTimeoutMs,5000)}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${__P(benchTimeoutMs,5000)}</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Tag warmup or sample by request start" enabled="true">
            <stringProp name="cacheKey">s2-label-by-start-v1</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import org.apache.jmeter.threads.JMeterContextService
def startedAt = JMeterContextService.getTestStartTime()
vars.put('benchStartMs', Long.toString(startedAt))
def preludeMs = Long.parseLong(props.getProperty('benchPrelude', '3')) * 1000L
def warmupMs = Long.parseLong(props.getProperty('benchWarmup', '1')) * 1000L
def sampleMs = Long.parseLong(props.getProperty('benchSample', '1')) * 1000L
def elapsed = prev.getStartTime() - startedAt
prev.setSampleLabel(elapsed &lt; preludeMs + warmupMs ? 'S2-warmup' :
    (elapsed &lt; preludeMs + warmupMs + sampleMs ? 'S2-sample' : 'S2-tail'))
</stringProp>
          </JSR223PostProcessor>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP 200 and Square cursor payload" enabled="true">
            <stringProp name="cacheKey">s2-cursor-payload-v1</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper
try {
    def value = new JsonSlurper().parse(prev.getResponseData())
    def rows = value?.data?.items
    if (prev.getResponseCode() != '200' || value?.code != 'OK' ||
            !(rows instanceof List) || rows.size() != 20 ||
            !(value.data.nextCursor instanceof String) || value.data.nextCursor.isEmpty() ||
            !rows.any { row -&gt;
                def id = row?.id?.toString()
                id ==~ /930000\d{6}/ &amp;&amp; id.toLong() &gt; 930000000000L &amp;&amp; id.toLong() &lt;= 930000100000L
            }) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Unexpected S2 cursor response')
    }
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Invalid S2 cursor response')
}
</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>