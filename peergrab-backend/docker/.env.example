# Copy to .env for the loopback-only local demo. The four passwords below are public demo credentials.
# .env is ignored by git. Do not enable demo login with these credentials outside this demo.
COMPOSE_PROJECT_NAME=peergrab-local
PEERGRAB_MYSQL_PASSWORD=change-this-local-db-password
PEERGRAB_AUTH_DEMO_PASSWORD_1001=demo1001
PEERGRAB_AUTH_DEMO_PASSWORD_2001=demo2001
PEERGRAB_AUTH_DEMO_PASSWORD_2002=demo2002
PEERGRAB_AUTH_DEMO_PASSWORD_9001=demo9001
# Optional: set PEERGRAB_AUTH_MODE=jwt and provide at least 32 UTF-8 bytes for this secret.
PEERGRAB_AUTH_MODE=session
PEERGRAB_AUTH_JWT_SECRET=

# Host ports are bound to 127.0.0.1; container-to-container ports stay unchanged.
PEERGRAB_WEB_PORT=25173
PEERGRAB_API_PORT=28080
PEERGRAB_MYSQL_PORT=13307
PEERGRAB_REDIS_PORT=16380
PEERGRAB_RMQ_NAMESRV_PORT=19876
PEERGRAB_RMQ_BROKER_PORT=20911
PEERGRAB_RMQ_FAST_PORT=20909
PEERGRAB_RMQ_PROXY_PORT=18081
