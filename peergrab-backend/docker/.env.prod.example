# Copy to .env.prod (ignored by git), chmod 600, then generate both database passwords.
# Demo credentials are public and match the frontend's prefilled values. Virtual funds only.
COMPOSE_PROJECT_NAME=peergrab-prod
PEERGRAB_WEB_PORT=25173
PEERGRAB_MYSQL_ROOT_PASSWORD=
PEERGRAB_MYSQL_APP_PASSWORD=
PEERGRAB_AUTH_JWT_SECRET=
PEERGRAB_AUTH_DEMO_PASSWORD_1001=demo1001
PEERGRAB_AUTH_DEMO_PASSWORD_2001=demo2001
PEERGRAB_AUTH_DEMO_PASSWORD_2002=demo2002
PEERGRAB_AUTH_DEMO_PASSWORD_9001=demo9001
# 可选：内部端点第二凭证（≥32 字节）；不设置则仅依赖仲裁员 Bearer + Nginx 404。
# PEERGRAB_INTERNAL_TOKEN=
# 公开演示默认 true；正式生产设 false 并接入真实身份系统。
