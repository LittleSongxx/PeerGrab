# Copy to ignored .env.bench; use new secrets and a never-reused project name.
COMPOSE_PROJECT_NAME=peergrab-bench-example
PEERGRAB_MYSQL_PASSWORD=replace-with-unique-secret
PEERGRAB_AUTH_MODE=jwt
PEERGRAB_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# Use a separate fresh project with false for the S5 fallback comparison.
PEERGRAB_BENCH_MQ_ENABLED=true
# Set exactly one of these at a time for A/B; use a fresh stack per variant.
PEERGRAB_BENCH_CACHE_ENABLED=true
PEERGRAB_BENCH_CACHE_SHARDS=4
PEERGRAB_BENCH_LIMIT_ENABLED=true
PEERGRAB_BENCH_LIMIT_TYPE=sentinel
PEERGRAB_BENCH_LIMIT_PER_SECOND=500
PEERGRAB_BENCH_HIKARI_POOL_SIZE=20
PEERGRAB_BENCH_TOMCAT_THREADS_MAX=200
PEERGRAB_BENCH_CONFIRM_SECONDS=300
# For S5 MQ-only attribution set false; fallback-only runs keep true.
PEERGRAB_BENCH_TIMEOUT_SCAN_ENABLED=true
PEERGRAB_BENCH_TIMEOUT_SCAN_INTERVAL_MS=5000
PEERGRAB_BENCH_SETTLE_SCAN_INTERVAL_MS=5000
PEERGRAB_AUTH_DEMO_PASSWORD_1001=replace-with-unique-secret
PEERGRAB_AUTH_DEMO_PASSWORD_2001=replace-with-unique-secret
PEERGRAB_AUTH_DEMO_PASSWORD_2002=replace-with-unique-secret
PEERGRAB_AUTH_DEMO_PASSWORD_9001=replace-with-unique-secret
# These bindings stay on the Docker host loopback interface.
PEERGRAB_API_PORT=38080
PEERGRAB_MYSQL_PORT=33307
PEERGRAB_REDIS_PORT=36380
# Only the MQ proxy is published to loopback for host-side S5 probes.
PEERGRAB_RMQ_NAMESRV_PORT=39876
PEERGRAB_RMQ_BROKER_PORT=40911
PEERGRAB_RMQ_FAST_PORT=40909
PEERGRAB_RMQ_PROXY_PORT=38081
