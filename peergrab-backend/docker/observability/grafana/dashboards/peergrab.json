  },
  "description": "PeerGrab 最小可观测性看板：API 业务结果、抢单阶段延迟、资金/延迟消息 outbox 积压、对账差异、进程与 JVM 资源。数据来自 app:8080 与 worker:8082 的 /actuator/prometheus。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
      "description": "按 Result.code 拆分的业务结果速率。抢单失败（SLOT_FULL、GRAB_CONFLICT 等）同样是 HTTP 200，只看 HTTP 状态码会漏掉这些结果。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
          "editorMode": "code",
          "expr": "sum by (code) (rate(peergrab_api_results_total[1m]))",
          "legendFormat": "{{code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API 业务结果速率（按 code）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
      "description": "code!=OK 的占比。抢单本身是高失败率场景，该值天然偏高，只作异常哨兵；阈值需要按压测/生产口径调整。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(peergrab_api_results_total{code!=\"OK\"}[5m])) / clamp_min(sum(rate(peergrab_api_results_total[5m])), 0.001)",
          "legendFormat": "非 OK 占比",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API 非 OK 结果占比",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
      "description": "抢单用例各阶段 P99（去掉了鉴权与 Servlet 排队）。Timer 带 publishPercentileHistogram()，因此输出 _bucket，可直接用 histogram_quantile。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(peergrab_grab_phase_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "抢单阶段 P99（按 stage）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
      "description": "http_server_requests_seconds 是 summary（没有 _bucket），所以这里用 sum/count 求平均；P99 请看抢单阶段面板。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "peergrab-prometheus" },
          "editorMode": "code",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[5m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[5m])), 0.001)",
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 平均响应时间（按 URI）",
      "type": "timeseries"
    },
    {
